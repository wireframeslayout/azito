<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  AZITO が同梱する misao デーモンの launchd ユーザーエージェント (macOS)。ハブ (com.azito.hub) とは別のサービス:
  misao を止めると全ペインが閉じるため、ハブの再起動・更新に巻き込まない。
  __AZITO_PREFIX__ と __PATH__ は install 時に絶対パスへ置き換える (launchd は ~ や %h を展開しない)。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.azito.misao</string>
  <key>ProgramArguments</key>
  <array>
    <string>__AZITO_PREFIX__/hub/current/node</string>
    <string>__AZITO_PREFIX__/misao/current/misao.mjs</string>
    <string>serve</string>
    <string>--socket</string>
    <string>__AZITO_PREFIX__/misao/misao.sock</string>
    <string>--data</string>
    <string>__AZITO_PREFIX__/misao</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- 異常終了 (クラッシュ・非ゼロ終了) のときだけ再起動する。systemd の Restart=on-failure と同じ。
       停止操作で正常に止まった (終了コード 0) ときは再起動しない。 -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>1</integer>
  <!-- 停止時は、デーモンが自分で pane を閉じる。launchd が子プロセスを先に殺さない。 -->
  <key>AbandonProcessGroup</key>
  <true/>
  <!-- pane の子プロセスが見るロケールと PATH。launchd の既定は UTF-8 でも Homebrew/nvm 入りでもない。 -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__AZITO_PREFIX__/misao/misao.log</string>
  <key>StandardErrorPath</key>
  <string>__AZITO_PREFIX__/misao/misao.log</string>
</dict>
</plist>
