# ============================================================================
# This file is the template for TWO env files:
#   - <repo root>/.env          -> read by `docker compose` (MinIO only)
#   - packages/server/.env      -> read by the AZITO server (everything else)
# Each section below notes which file it belongs to. Both should be mode 600.
# ============================================================================

# --- MinIO (<repo root>/.env; only needed when using file storage) ---
# Required when running docker-compose.yml — `docker compose up` fails if unset.
# Generate with: openssl rand -hex 24  /  openssl rand -hex 32
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Push notifications (packages/server/.env) ---
# Contact address sent to push services as the VAPID subject (mailto: or https: URL).
# AZITO_VAPID_SUBJECT=mailto:you@example.com

# --- Webhooks (packages/server/.env) ---
# Shared token between the AZITO server and Claude Code hooks.
# If unset, a random token is generated on each server start.
# AZITO_WEBHOOK_TOKEN=

# --- UI Authentication (packages/server/.env) ---
# Optional. Token for API/WebSocket authentication.
# If unset, auto-generated to $AZITO_DATA_DIR/ui-token on first start.
# View with: azito token show   Rotate with: azito token rotate
# Generate a fixed token with: openssl rand -hex 32
# AZITO_UI_TOKEN=

# --- Data Directory (packages/server/.env) ---
# Optional. When set, all persistent data (data.db, master.key, vapid-keys.json,
# ui-token, browser-profile/, sidekicks/) is stored under this directory (mode 700).
# Default: repo root (data.db at root, others under data/).
# AZITO_DATA_DIR=

# --- CORS (packages/server/.env) ---
# Comma-separated list of allowed origins for CORS.
# Default: http://localhost:5173,http://localhost:3001
# AZITO_ALLOWED_ORIGINS=
